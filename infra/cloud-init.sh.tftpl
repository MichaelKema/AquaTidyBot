#!/bin/bash
set -euo pipefail
umask 077
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y docker.io jq sqlite3
systemctl enable --now docker

# Keep SQLite outside the container on this instance's existing root disk.
install -d -m 700 /var/lib/aquatidy /var/lib/aquatidy/data /var/lib/aquatidy/backups
cat > /etc/aquatidy.json <<'CONFIG'
{"repository":"${repository}"}
CONFIG
cat > /usr/local/bin/aquatidy-deploy <<'DEPLOY'
${deploy_script}
DEPLOY
cat > /usr/local/bin/aquatidy-run <<'RUN'
${run_script}
RUN
chmod 700 /usr/local/bin/aquatidy-deploy /usr/local/bin/aquatidy-run
cat > /etc/systemd/system/aquatidy.service <<'SERVICE'
[Unit]
Description=AquaTidy Discord bot
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/aquatidy
ConditionPathExists=/var/lib/aquatidy/image

[Service]
ExecStartPre=/usr/bin/test -d /var/lib/aquatidy/data
ExecStartPre=-/usr/bin/docker rm -f aquatidy
ExecStart=/usr/local/bin/aquatidy-run
ExecStop=-/usr/bin/docker stop --time 30 aquatidy
Restart=always
RestartSec=10
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
SERVICE
systemctl daemon-reload
systemctl enable aquatidy
# /run is cleared on reboot. Deployments need this readiness marker then too.
cat > /etc/systemd/system/aquatidy-ready.service <<'SERVICE'
[Unit]
Description=Mark AquaTidy host ready for deployments
Requires=docker.service
After=docker.service
RequiresMountsFor=/var/lib/aquatidy

[Service]
Type=oneshot
ExecStart=/usr/bin/test -d /var/lib/aquatidy/data
ExecStart=/usr/bin/touch /run/aquatidy-ready
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
SERVICE
systemctl daemon-reload
systemctl enable --now aquatidy-ready
# Start an existing installation after refreshing its service definitions.
if [ -f /var/lib/aquatidy/image ]; then
  systemctl start aquatidy
fi

cat > /usr/local/bin/aquatidy-backup <<'BACKUP'
${backup_script}
BACKUP
chmod 700 /usr/local/bin/aquatidy-backup
cat > /etc/systemd/system/aquatidy-backup.service <<'SERVICE'
[Unit]
Description=Back up AquaTidy SQLite settings

[Service]
Type=oneshot
ExecStart=/usr/local/bin/aquatidy-backup
SERVICE
cat > /etc/systemd/system/aquatidy-backup.timer <<'TIMER'
[Unit]
Description=Daily AquaTidy database backup

[Timer]
OnCalendar=daily
Persistent=true
RandomizedDelaySec=10m

[Install]
WantedBy=timers.target
TIMER
systemctl daemon-reload
systemctl enable --now aquatidy-backup.timer
